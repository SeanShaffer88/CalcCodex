<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- CalcDex x64 MSI — per-user install, mirrors the NSIS installer.
       Build: wix build installer/CalcDex.wxs -o dist/CalcDex-Setup-x86_64.msi
       The uninstall entry is created by Windows Installer itself (ARP). -->
  <Package Name="CalcDex" Manufacturer="Sean Shaffer" Version="0.8.0"
           UpgradeCode="56d35f3a-122b-40c2-9e0a-31324514ff8c"
           Scope="perUser" Compressed="yes">

    <SummaryInformation Description="CalcDex 0.8.0 (x64) installer" />
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of CalcDex is already installed." />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="CalcDex" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="CalcDex" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="CompExe" Guid="433b8420-273d-49c0-a7f0-764fcedd01b7" Bitness="always64">
        <File Id="CalcDexExe" Source="dist/CalcDex.exe" KeyPath="yes" />
      </Component>
      <Component Id="CompDoc" Guid="28176ff5-79ea-458e-b3dc-936af9df0393" Bitness="always64">
        <File Id="LicenseFile" Source="LICENSE" />
        <File Id="ReadmeFile" Source="README.md" />
      </Component>
    </ComponentGroup>

    <Component Id="CompShortcut" Directory="AppMenuFolder" Guid="8233383a-476e-4104-9cc8-25ecedca6991">
      <Shortcut Id="StartMenuShortcut" Name="CalcDex"
                Target="[INSTALLFOLDER]CalcDex.exe"
                WorkingDirectory="INSTALLFOLDER"
                Description="CalcDex — offline calculator" />
      <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\CalcDex" Name="StartMenuShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="CalcDex" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="CompShortcut" />
    </Feature>
  </Package>
</Wix>
