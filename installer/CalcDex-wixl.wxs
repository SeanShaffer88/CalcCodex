<?xml version="1.0" encoding="utf-8"?>
<!-- CalcDex x64 MSI (wixl / msitools dialect, WiX v3 schema) — per-user
     install mirroring the NSIS installer: program files + Start Menu
     shortcut; Windows Installer creates the uninstall (ARP) entry itself.
     Build from the repo root:
       wixl -a x64 -o dist/CalcDex-Setup-x86_64.msi installer/CalcDex-wixl.wxs -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="CalcDex" Language="1033" Version="0.8.0"
           Manufacturer="Sean Shaffer"
           UpgradeCode="56d35f3a-122b-40c2-9e0a-31324514ff8c">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perUser" />
    <Media Id="1" Cabinet="app.cab" EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of CalcDex is already installed." />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="CalcDex">
            <Component Id="CompExe" Guid="433b8420-273d-49c0-a7f0-764fcedd01b7">
              <File Id="CalcDexExe" Name="CalcDex.exe" Source="dist/CalcDex.exe" KeyPath="yes" />
            </Component>
            <Component Id="CompDoc" Guid="28176ff5-79ea-458e-b3dc-936af9df0393">
              <File Id="LicenseFile" Name="LICENSE" Source="LICENSE" />
              <File Id="ReadmeFile" Name="README.md" Source="README.md" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuFolder" Name="CalcDex">
          <Component Id="CompShortcut" Guid="8233383a-476e-4104-9cc8-25ecedca6991">
            <Shortcut Id="StartMenuShortcut" Name="CalcDex"
                      Target="[INSTALLFOLDER]CalcDex.exe"
                      WorkingDirectory="INSTALLFOLDER"
                      Description="CalcDex — offline calculator" />
            <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\CalcDex" Name="StartMenuShortcut"
                           Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="CalcDex" Level="1">
      <ComponentRef Id="CompExe" />
      <ComponentRef Id="CompDoc" />
      <ComponentRef Id="CompShortcut" />
    </Feature>
  </Product>
</Wix>
